# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database ---
# Local dev example (matches docker-compose service below):
DATABASE_URL="postgresql://issueflow:issueflow@localhost:5432/issueflow?schema=public"

# --- Auth ---
# Generate a strong random value, e.g.: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# --- CORS / client origins ---
# Comma-separated list of exact origins allowed to call this API.
ALLOWED_ORIGIN=http://localhost:5173

# --- Logging ---
LOG_LEVEL=info
