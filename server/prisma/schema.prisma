// IssueFlow database schema.
//
// Phase 1: User. Phase 2: Project + ProjectMembership. Domain model per
// the product spec, Appendix A. More tables (Issue, Label, Comment,
// BoardPlacement) arrive later in Phase 2/3.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// AUTH-01/AUTH-03: a registered, authenticated person. The password is
// never stored in plain text (passwordHash only) and this model should
// never be serialized straight to JSON in an API response - always pick
// only the fields that are safe to expose (see AppError/response shaping
// once the signup/login routes exist).
model User {
  id           String   @id @default(cuid())
  // Normalized (lowercased, trimmed) before it ever reaches this column -
  // that normalization is application logic, not something Postgres does
  // for us. @unique enforces the "unique" half of "unique normalized email".
  email        String   @unique
  displayName  String   @map("display_name")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedProjects Project[]           @relation("ProjectOwner")
  memberships   ProjectMembership[]

  @@map("users")
}

// PRJ-01: a workspace containing issues and one board. `ownerId` is a
// direct pointer to the owner for fast "who owns this" lookups, kept in
// sync with the corresponding ProjectMembership row (role: owner) that
// PRJ-01 requires the creator to also get - two places recording the
// same fact on purpose, not duplication by accident. The application
// layer (project creation) is what keeps them consistent; nothing at
// the schema level enforces that automatically.
model Project {
  id          String  @id @default(cuid())
  name        String
  // PRJ-01: "required name and optional description".
  description String?

  ownerId String @map("owner_id")
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id])

  memberships ProjectMembership[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("projects")
}

// owner/member per the spec's MVP authorization model (§4) - no custom
// roles in Phase 1/2. Enum values map to lowercase in Postgres to match
// the spec's own casing, while staying idiomatic (SCREAMING_CASE) on the
// TypeScript side - same split as camelCase-in-code / snake_case-in-SQL
// used throughout this schema.
enum ProjectRole {
  OWNER  @map("owner")
  MEMBER @map("member")
}

// Pure join table connecting a User to a Project with a role. The pair
// itself is the identity - no separate `id` column, `@@id` below makes
// (projectId, userId) the primary key directly, which is a stronger
// guarantee than a separate `id` plus a unique index on the same two
// columns would be, and matches the spec's own field list for this
// entity exactly (no `id` listed).
model ProjectMembership {
  projectId String      @map("project_id")
  userId    String      @map("user_id")
  role      ProjectRole
  joinedAt  DateTime    @default(now()) @map("joined_at")

  // Deleting a project or a user removes their membership rows with
  // them - membership has no meaning independent of both sides existing.
  // This is unrelated to comment/issue authorship preservation (a later
  // phase's concern) - a membership row isn't an attributed record the
  // way a comment is.
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_memberships")
}
