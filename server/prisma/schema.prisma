// IssueFlow database schema.
//
// Phase 1: User. Phase 2: Project + ProjectMembership, Issue +
// BoardPlacement. Domain model per the product spec, Appendix A. Label
// and Comment arrive in Phase 3.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// AUTH-01/AUTH-03: a registered, authenticated person. The password is
// never stored in plain text (passwordHash only) and this model should
// never be serialized straight to JSON in an API response - always pick
// only the fields that are safe to expose (see AppError/response shaping
// once the signup/login routes exist).
model User {
  id           String   @id @default(cuid())
  // Normalized (lowercased, trimmed) before it ever reaches this column -
  // that normalization is application logic, not something Postgres does
  // for us. @unique enforces the "unique" half of "unique normalized email".
  email        String   @unique
  displayName  String   @map("display_name")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedProjects    Project[]           @relation("ProjectOwner")
  memberships      ProjectMembership[]
  authoredIssues   Issue[]             @relation("IssueAuthor")
  assignedIssues   Issue[]             @relation("IssueAssignee")
  authoredComments Comment[]           @relation("CommentAuthor")
  commentMentions  CommentMention[]

  @@map("users")
}

// PRJ-01: a workspace containing issues and one board. `ownerId` is a
// direct pointer to the owner for fast "who owns this" lookups, kept in
// sync with the corresponding ProjectMembership row (role: owner) that
// PRJ-01 requires the creator to also get - two places recording the
// same fact on purpose, not duplication by accident. The application
// layer (project creation) is what keeps them consistent; nothing at
// the schema level enforces that automatically.
model Project {
  id          String  @id @default(cuid())
  name        String
  // PRJ-01: "required name and optional description".
  description String?

  ownerId String @map("owner_id")
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id])

  // ISS-06: an issue's `number` (like GitHub's #1, #2, ...) is unique
  // per-project, not global - see the unique constraint on Issue below.
  // This counter is the source of the next value. It's schema
  // infrastructure only: the atomic "read and increment" logic that
  // makes concurrent issue creation safe lives in the issue-creation
  // code (Phase 2, create-issue day), not here.
  nextIssueNumber Int @default(1) @map("next_issue_number")

  memberships     ProjectMembership[]
  issues          Issue[]
  boardPlacements BoardPlacement[]
  labels          Label[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("projects")
}

// owner/member per the spec's MVP authorization model (§4) - no custom
// roles in Phase 1/2. Enum values map to lowercase in Postgres to match
// the spec's own casing, while staying idiomatic (SCREAMING_CASE) on the
// TypeScript side - same split as camelCase-in-code / snake_case-in-SQL
// used throughout this schema.
enum ProjectRole {
  OWNER  @map("owner")
  MEMBER @map("member")
}

// Pure join table connecting a User to a Project with a role. The pair
// itself is the identity - no separate `id` column, `@@id` below makes
// (projectId, userId) the primary key directly, which is a stronger
// guarantee than a separate `id` plus a unique index on the same two
// columns would be, and matches the spec's own field list for this
// entity exactly (no `id` listed).
model ProjectMembership {
  projectId String      @map("project_id")
  userId    String      @map("user_id")
  role      ProjectRole
  joinedAt  DateTime    @default(now()) @map("joined_at")

  // Deleting a project or a user removes their membership rows with
  // them - membership has no meaning independent of both sides existing.
  // This is unrelated to comment/issue authorship preservation (a later
  // phase's concern) - a membership row isn't an attributed record the
  // way a comment is.
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_memberships")
}

// §1.2 / §5.2: the four board columns are fixed in the MVP, and issue
// workflow status *is* the board column - not a separate concept. An
// enum makes an invalid status a schema-level impossibility, not just
// something application code has to remember to check.
enum IssueStatus {
  BACKLOG      @map("backlog")
  TODO         @map("todo")
  IN_PROGRESS  @map("in_progress")
  DONE         @map("done")
}

// The single source of truth for a work item (§5.2: "A card is never a
// separate copy of an issue"). `number` is scoped per-project (see
// Project.nextIssueNumber above) - the unique constraint below is what
// ISS-06 ("an issue always belongs to exactly one project") actually
// means at the database level for numbering.
model Issue {
  id          String      @id @default(cuid())
  projectId   String      @map("project_id")
  number      Int
  title       String
  description String?
  status      IssueStatus @default(BACKLOG)

  authorId   String  @map("author_id")
  // ASN-01/ASN-02: zero or one assignee, and only ever a current
  // project member - that membership check is application logic
  // (Phase 3, when assignment gets built), not something a foreign
  // key alone can express, since "member of project X" isn't a fact
  // the User table can encode about itself.
  assigneeId String? @map("assignee_id")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author   User    @relation("IssueAuthor", fields: [authorId], references: [id])
  assignee User?   @relation("IssueAssignee", fields: [assigneeId], references: [id])

  // Prisma requires the non-FK side of a 1:1 relation to be optional in
  // its type system, even though the application guarantees every
  // issue actually gets a placement row (created atomically alongside
  // the issue itself, same pattern as Project+ProjectMembership - see
  // D-11). The `?` here is a Prisma limitation, not a real possibility.
  boardPlacement BoardPlacement?

  comments Comment[]
  labels   IssueLabel[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, number])
  @@index([projectId, status])
  @@map("issues")
}

// §5.2: "Each issue has one board-placement record... does not
// duplicate issue content or status." `issueId` as the primary key
// (not a separate `id`) makes "exactly one placement per issue"
// structural, the same reasoning as ProjectMembership's composite key.
//
// `rank` is a String, not an Int: flexible enough for either ranking
// approach the spec allows (D-03, still open) - fractional/lexicographic
// ranking (e.g. LexoRank-style strings) or a plain stringified integer
// for transactional reordering. Deciding which is Phase 4's job
// (Day 33: "decide the card-ranking approach"); today only commits to
// a column type that doesn't foreclose either option.
//
// `projectId` is denormalized from the issue's own project on purpose
// (fast board queries scoped to one project without a join) - it must
// always match issue.projectId. Nothing at the schema level enforces
// that agreement (Postgres has no native cross-table check constraint
// for this); the service layer that creates a placement always derives
// it from the issue's own projectId, never accepts it as separate input.
model BoardPlacement {
  issueId   String   @id @map("issue_id")
  projectId String   @map("project_id")
  rank      String
  version   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  issue   Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, rank])
  @@map("board_placements")
}

// COM-01/COM-02: a discussion post on an issue, and its own replies
// (threaded, via a self-relation). `bodyMarkdown` is exactly what the
// author submitted; `bodyHtml` is the sanitized HTML rendering of it,
// computed once at write time (see DECISIONS.md D-15 for the
// marked+sanitize-html choice and why rendering happens server-side,
// at creation, rather than on every read or client-side). Comments
// aren't editable yet (no scheduled day for it up to Phase 3's exit
// gate), so a stored, not recomputed-per-request, HTML rendering can't
// go stale - if editing arrives later, that's the moment `bodyHtml`
// needs to be recomputed on update too, not before.
model Comment {
  id           String   @id @default(cuid())
  issueId      String   @map("issue_id")
  authorId     String   @map("author_id")
  // COM-03: a reply's parent must be a comment on the *same* issue -
  // enforced in the service layer (a foreign key alone can't express
  // "and also matches this other row's issueId"), not here.
  parentId     String?  @map("parent_id")
  bodyMarkdown String   @map("body_markdown")
  bodyHtml     String   @map("body_html")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  issue  Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User    @relation("CommentAuthor", fields: [authorId], references: [id])
  // Deleting a parent comment cascades to its replies - an orphaned
  // reply with no parent to thread under isn't a state worth keeping
  // around; Comment has no independent meaning once its own thread
  // context is gone (mirrors the reasoning on ProjectMembership above).
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  mentions CommentMention[]

  @@index([issueId, createdAt])
  @@map("comments")
}

// MEN-01: who a comment @mentions, resolved to real project members at
// write time (see issues.service.ts-style resolution in
// comments.service.ts) - not a live parse of the markdown on every
// read. A pure join table, same reasoning as ProjectMembership/
// IssueLabel: the (commentId, userId) pair is the whole fact.
model CommentMention {
  commentId String @map("comment_id")
  userId    String @map("user_id")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@map("comment_mentions")
}

// LBL-01: a project-scoped classification tag. Unique per (projectId,
// name) - "bug" in Project A and "bug" in Project B are unrelated
// labels, but the same name can't be defined twice within one project.
model Label {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  name      String
  // Hex color (e.g. "#d73a4a", GitHub's own default palette convention)
  // - validated in the Zod schema, not here; Postgres has no native hex
  // check constraint worth reaching for over an application-level one.
  color     String
  createdAt DateTime @default(now()) @map("created_at")

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  IssueLabel[]

  @@unique([projectId, name])
  @@map("labels")
}

// Pure join table, same shape as ProjectMembership: the (issueId,
// labelId) pair is the entire fact, no separate `id` needed.
model IssueLabel {
  issueId String @map("issue_id")
  labelId String @map("label_id")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@map("issue_labels")
}
