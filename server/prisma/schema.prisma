// IssueFlow database schema.
//
// Phase 0: only the datasource/generator exist, so we can prove the
// server can reach Postgres end to end. Real tables (User, Project,
// Issue, etc.) get added in Phase 1/2 per the domain model in the
// product spec (Appendix A).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
